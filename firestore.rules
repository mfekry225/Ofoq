rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check and connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // App Settings (Teacher Profile & Configuration)
    match /app_settings/{docId} {
      allow read, write: if true;
    }

    // Students Collection - direct cross-device synchronization
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Sessions Collection
    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    // Timelines Collection
    match /timelines/{timelineId} {
      allow read, write: if true;
    }

    // Leads (Enrollment Inquiries)
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // Allow all other application documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


