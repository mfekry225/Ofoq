rules_version = '2';

// قواعد أمان منصة أُفق
// - الأخصائي: له مستند في admins/{uid} (يُنشأ يدوياً من Firebase Console). يقرأ ويكتب كل شيء.
// - ولي الأمر: له مستند في parents/{uid} يحدد الطالب المرتبط به. يقرأ ملف طفله فقط ولا يكتب شيئاً
//   سوى نتائج التقييمات الخاصة بطفله.
// - الزائر (بدون دخول): يقرأ الملف العام للأخصائي ويرسل طلب تسجيل فقط، ولا يقرأ أي شيء آخر.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- دوال مساعدة ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isParentOf(studentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/parents/$(request.auth.uid))
        && get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.studentId == studentId;
    }

    function validId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function optStr(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    // ---------- التحقق من البيانات ----------
    function validStudent(d) {
      return d.id is string && d.id.size() <= 128
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.parentName is string && d.parentName.size() <= 100
        && d.parentPhone is string && d.parentPhone.size() <= 30
        && !('parentPassword' in d)
        && !('parentAccessCode' in d)
        && optStr(d, 'parentUid', 128)
        && optStr(d, 'parentUsername', 50)
        && optStr(d, 'notes', 2000)
        && optStr(d, 'diagnosis', 300);
    }

    function validSession(d) {
      return d.id is string && d.id.size() <= 128
        && d.studentId is string && d.studentId.size() <= 128
        && d.date is string && d.date.size() <= 30;
    }

    function validTimeline(d) {
      return d.id is string && d.id.size() <= 128
        && d.studentId is string && d.studentId.size() <= 128
        && d.title is string && d.title.size() <= 250
        && d.date is string && d.date.size() <= 30;
    }

    function validAssessment(d) {
      return d.id is string && d.id.size() <= 128
        && d.scaleId is string && d.scaleId.size() <= 50
        && d.date is string && d.date.size() <= 30
        && d.totalScore is number
        && optStr(d, 'studentId', 128)
        && optStr(d, 'notes', 2000);
    }

    // طلب التسجيل متاح للزوار، لذلك نقيّد الحقول والأحجام بصرامة
    function validLead(d) {
      return d.keys().hasOnly([
          'id', 'parentName', 'studentName', 'studentAge', 'subjectNeeded',
          'phone', 'motherPhone', 'preferredTime', 'notes', 'status', 'createdAt'
        ])
        && d.parentName is string && d.parentName.size() >= 2 && d.parentName.size() <= 100
        && d.phone is string && d.phone.size() >= 6 && d.phone.size() <= 30
        && d.status == 'new'
        && optStr(d, 'id', 128)
        && optStr(d, 'studentName', 100)
        && optStr(d, 'studentAge', 50)
        && optStr(d, 'subjectNeeded', 150)
        && optStr(d, 'motherPhone', 30)
        && optStr(d, 'preferredTime', 100)
        && optStr(d, 'notes', 1000)
        && optStr(d, 'createdAt', 50);
    }

    function validParent(d) {
      return d.keys().hasOnly(['studentId', 'username', 'createdAt'])
        && d.studentId is string && d.studentId.size() <= 128
        && d.username is string && d.username.size() <= 50;
    }

    // ---------- المجموعات ----------

    // حسابات الأخصائي: القراءة لصاحب الحساب فقط، والكتابة من Console فقط
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ربط ولي الأمر بالطالب: يقرأه صاحبه، ويديره الأخصائي فقط
    match /parents/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create, update: if isOwner() && validParent(request.resource.data);
      allow delete: if isOwner();
    }

    // الملف العام للأخصائي: مقروء للجميع، والكتابة للأخصائي فقط
    match /app_settings/{settingId} {
      allow get: if settingId == 'profile' || isOwner();
      allow list: if isOwner();
      allow write: if isOwner();
    }

    match /students/{studentId} {
      allow get: if isOwner() || isParentOf(studentId);
      allow list: if isOwner();
      allow create, update: if isOwner() && validId(studentId) && validStudent(request.resource.data);
      allow delete: if isOwner();
    }

    match /sessions/{sessionId} {
      allow get, list: if isOwner() || isParentOf(resource.data.studentId);
      allow create, update: if isOwner() && validId(sessionId) && validSession(request.resource.data);
      allow delete: if isOwner();
    }

    match /timelines/{timelineId} {
      allow get, list: if isOwner() || isParentOf(resource.data.studentId);
      allow create, update: if isOwner() && validId(timelineId) && validTimeline(request.resource.data);
      allow delete: if isOwner();
    }

    // التقييمات: ولي الأمر يضيف تقييماً لطفله فقط (إنشاء فقط، بلا تعديل أو حذف)
    match /assessments/{assessmentId} {
      allow get, list: if isOwner() || isParentOf(resource.data.studentId);
      allow create: if validId(assessmentId)
        && validAssessment(request.resource.data)
        && (isOwner()
            || ('studentId' in request.resource.data && isParentOf(request.resource.data.studentId)));
      allow update, delete: if isOwner();
    }

    // طلبات التسجيل: الزائر يرسل فقط، والأخصائي وحده يقرأ ويدير
    match /leads/{leadId} {
      allow create: if validId(leadId) && validLead(request.resource.data);
      allow get, list, update, delete: if isOwner();
    }

    // أي مسار آخر مرفوض
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
